@model ChangePasswordRequestModel

@{
    Layout = "_LayoutExterno";
}

<div class="login-wrapper">
    <div class="login-bg-shape login-bg-shape-1"></div>
    <div class="login-bg-shape login-bg-shape-2"></div>

    <div class="login-card">

        <a asp-action="Login" asp-controller="Home" class="login-brand text-decoration-none">
            <i class="bi bi-asterisk"></i>
            <span>Proyecto JN</span>
        </a>

        <form asp-action="ChangePassword" asp-controller="Home" method="post" id="loginForm" class="needs-validation" novalidate>

            @Html.AntiForgeryToken()

            @if (!string.IsNullOrEmpty(ViewBag.Mensaje))
            {
                <div class="alert alert-info text-center" role="alert">
                    @ViewBag.Mensaje
                </div>
            }

            <div class="login-form-group">
                <label for="ContrasennaNueva" class="login-form-label">Contraseña Nueva</label>
                <div class="login-input-group">
                    <i class="bi bi-shield-lock input-icon"></i>
                    <input type="password" asp-for="ContrasennaNueva" value="@Model?.ContrasennaNueva" class="login-input login-input-password">
                    <button type="button" class="password-toggle-btn" id="toggle-password" aria-label="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="ContrasennaNueva" class="text-danger small d-block mt-1"></span>
            </div>

            <div class="login-form-group">
                <label for="ConfirmarContrasenna" class="login-form-label">Confirmar Contraseña</label>
                <div class="login-input-group">
                    <i class="bi bi-shield-lock input-icon"></i>
                    <input type="password" asp-for="ConfirmarContrasenna" value="@Model?.ConfirmarContrasenna" class="login-input login-input-password">
                    <button type="button" class="password-toggle-btn" id="toggle-password" aria-label="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmarContrasenna" class="text-danger small d-block mt-1"></span>
            </div>

            <button type="submit" class="btn-login" id="btn-submit">
                <span>Procesar</span>
            </button>

        </form>

    </div>
</div>