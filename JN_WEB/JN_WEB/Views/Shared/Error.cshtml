@{
    var autenticado = Context.Session.GetInt32("Autenticado");

    if (autenticado != 1)
    {
        Layout = "_LayoutExterno";
    }
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5 text-center">
                    <h1 class="display-6 fw-semibold text-danger mb-3">Ha ocurrido un problema</h1>
                    <p class="text-secondary mb-4">
                        Ocurrió un error mientras se procesaba tu solicitud. Intenta nuevamente en unos minutos.
                    </p>

                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2 mb-4">
                        <a href="/" class="btn btn-primary px-4">Ir al inicio</a>
                        <button type="button" class="btn btn-outline-secondary px-4" onclick="history.back()">Volver</button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
