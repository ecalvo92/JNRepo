@model PerfilUsuarioViewModel

<div class="page-header">
    <div>
        <h1 class="page-title">Mi Perfil</h1>
        <p class="page-subtitle">Actualice sus datos personales o cambie su contraseña de acceso.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(ViewBag.Mensaje))
{
    <div class="alert alert-info text-center" role="alert">
        @ViewBag.Mensaje
    </div>
}

<div class="row">

    <div class="col-xl-6">
        <div class="card">

            <div class="card-header">
                <h5 class="card-title">
                    <i class="bi bi-person me-2"></i>Datos personales
                </h5>
            </div>

            <form asp-action="ActualizarDatosPersonales" asp-controller="Usuario" method="post" novalidate>

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="DatosPersonales.Identificacion" class="form-label-custom">Identificación</label>
                    <div class="input-group-custom">
                        <span class="input-group-text-custom"><i class="bi bi-person-badge"></i></span>
                        <input type="text" asp-for="DatosPersonales.Identificacion" class="form-control-custom"
                               onkeyup="ConsultarNombrePersona('DatosPersonales_Identificacion', 'DatosPersonales_NombreCompleto');">
                    </div>
                    <span asp-validation-for="DatosPersonales.Identificacion" class="form-feedback-custom invalid-custom"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DatosPersonales.NombreCompleto" class="form-label-custom">Nombre Completo</label>
                    <div class="input-group-custom">
                        <span class="input-group-text-custom"><i class="bi bi-person"></i></span>
                        <input type="text" asp-for="DatosPersonales.NombreCompleto" class="form-control-custom" readonly="readonly">
                    </div>
                    <span asp-validation-for="DatosPersonales.NombreCompleto" class="form-feedback-custom invalid-custom"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="DatosPersonales.CorreoElectronico" class="form-label-custom">Correo Electrónico</label>
                    <div class="input-group-custom">
                        <span class="input-group-text-custom"><i class="bi bi-envelope"></i></span>
                        <input type="text" asp-for="DatosPersonales.CorreoElectronico" class="form-control-custom">
                    </div>
                    <span asp-validation-for="DatosPersonales.CorreoElectronico" class="form-feedback-custom invalid-custom"></span>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn-custom btn-custom-primary">
                        <i class="bi bi-check2-circle"></i>
                        <span>Guardar Datos</span>
                    </button>
                </div>

            </form>
        </div>
    </div>

    <div class="col-xl-6">
        <div class="card">

            <div class="card-header">
                <h5 class="card-title">
                    <i class="bi bi-shield-lock me-2"></i>Cambiar contraseña
                </h5>
            </div>

            <form asp-action="CambiarContrasenna" asp-controller="Usuario" method="post" novalidate>

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Contrasenna.ContrasennaNueva" class="form-label-custom">Contraseña Nueva</label>
                    <div class="input-group-custom">
                        <span class="input-group-text-custom"><i class="bi bi-shield-lock"></i></span>
                        <input type="password" asp-for="Contrasenna.ContrasennaNueva" class="form-control-custom" autocomplete="new-password">
                        <button type="button" class="input-group-text-custom border-0 password-toggle-btn position-static" aria-label="Show password">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Contrasenna.ContrasennaNueva" class="form-feedback-custom invalid-custom"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Contrasenna.ConfirmarContrasenna" class="form-label-custom">Confirmar Contraseña</label>
                    <div class="input-group-custom">
                        <span class="input-group-text-custom"><i class="bi bi-shield-check"></i></span>
                        <input type="password" asp-for="Contrasenna.ConfirmarContrasenna" class="form-control-custom" autocomplete="new-password">
                        <button type="button" class="input-group-text-custom border-0 password-toggle-btn position-static" aria-label="Show password">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Contrasenna.ConfirmarContrasenna" class="form-feedback-custom invalid-custom"></span>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn-custom btn-custom-primary">
                        <i class="bi bi-check2-circle"></i>
                        <span>Cambiar Contraseña</span>
                    </button>
                </div>

            </form>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/registro.js" asp-append-version="true"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
